# Copy to repo root as `.env.local` for local development (both apps via turbo dev).
# App: http://localhost:3000  |  Marketing: http://localhost:3001

NODE_ENV=development
CUSOWN_QUIET_INFRA_LOGS=false

# Supabase — from https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Local URLs (must match dev server ports)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001

# Secrets — generate: openssl rand -hex 32
CRON_SECRET=local-dev-cron-secret-min-16-chars # pragma: allowlist secret
SALON_TOKEN_SECRET=local-dev-salon-token-secret-min-32-chars # pragma: allowlist secret

# Optional: Redis (Upstash/local)
# REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Uploads
UPLOAD_STORAGE_BUCKET=uploads

# Feature flags
FEATURE_PAYMENT_CANARY=true
FEATURE_RESCHEDULE=true
FEATURE_NO_SHOW=true
