# CusOwn environment reference
#
# Use the right file for each context (copy examples to gitignored names):
#   Local dev     → cp env.local.example .env.local
#   Production    → env.production.example (set vars in Vercel; optional .env.production locally)
#   CI / strict   → cp env.test.example .env.test  (or run: node scripts/infrastructure/ensure-env-test.js)
#
# Monorepo: one `.env.local` / `.env.test` at repo root is loaded by turbo and Next apps.

# --- Quick reference (see example files for full lists) ---

# Local (env.local.example → .env.local)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_MARKETING_URL=http://localhost:3001

# Production (env.production.example → Vercel env)
# NEXT_PUBLIC_APP_URL=https://cusownapp.clykur.com
# NEXT_PUBLIC_MARKETING_URL=https://cusown.clykur.com

# Test / CI (env.test.example → .env.test)
# NEXT_PUBLIC_APP_URL=https://example.com
# CUSOWN_QUIET_INFRA_LOGS=true

# Required in all non-placeholder environments
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
SALON_TOKEN_SECRET=

# Optional sections (defaults in packages/config/src/env.ts)
# SIGNED_URL_TTL_SECONDS=86400
# AUDIT_RETENTION_DAYS=90
# UPLOAD_STORAGE_BUCKET=uploads
# REDIS_URL=  REDIS_ENABLED=true
# FEATURE_PAYMENT_CANARY=true
# NEXT_PUBLIC_SENTRY_DSN=
# EMAIL_*, TWILIO_*, BIGDATACLOUD_API_KEY, NOMINATIM_URL, OSRM_URL
