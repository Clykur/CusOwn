{
  "name": "cusown-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "overrides": {
    "next@^16.0.0": "16.2.6",
    "postcss": "8.5.14",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "fast-uri@^3.0.0": "3.1.2",
    "minimatch@^10.0.0": "10.2.5",
    "ip-address@^10.0.0": "10.2.0",
    "dompurify": "3.4.0",
    "immutable": "^4.3.8",
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- turbo dev",
    "build": "dotenv -e .env.local -- turbo build",
    "build:strict": "node scripts/infrastructure/ensure-env-test.js && dotenv -e .env.test -- node scripts/infrastructure/strict-build.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:strict": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "type-check": "turbo type-check",
    "typecheck": "npm run type-check",
    "test": "turbo test",
    "format": "prettier --write --config packages/config/src/quality/prettier.config.js \"apps/**/*.{js,jsx,ts,tsx,json,css,md}\" \"packages/**/*.{js,jsx,ts,tsx,json,css,md}\" \"scripts/**/*.{js,ts}\"",
    "format:check": "prettier --check --config packages/config/src/quality/prettier.config.js \"apps/**/*.{js,jsx,ts,tsx,json,css,md}\" \"packages/**/*.{js,jsx,ts,tsx,json,css,md}\" \"scripts/**/*.{js,ts}\"",
    "precommit:strict": "npm run lint && npm run type-check",
    "prepush:strict": "npm run guard:all",
    "prepare": "node scripts/infrastructure/prepare-husky.js",
    "guard:all": "node scripts/infrastructure/run-enterprise-guard.js",
    "security-check": "node scripts/infrastructure/security-check-pre-push.js",
    "security:audit": "npm audit --audit-level=high --production",
    "security:deps": "npm audit --audit-level=high --production",
    "security:gitleaks": "node scripts/infrastructure/run-detect-secrets.js",
    "security:custom:repo": "node scripts/infrastructure/validate-security-and-quality.js",
    "test:unit": "dotenv -e .env.test -- node scripts/infrastructure/run-unit-tests-runner.js",
    "test:unit:vitest": "dotenv -e .env.test -- vitest run --config vitest.unit.config.mts --coverage",
    "test:database-migrations": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/integration/database-migrations.test.ts",
    "test:crud": "dotenv -e .env.test -- vitest run scripts/unit-repositories --config vitest.config.mts --passWithNoTests && dotenv -e .env.test -- ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/integration/database-migrations.test.ts",
    "test:phase4": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/security/payment-safety.test.ts",
    "test:phase5": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/security/rbac-authorization.security.ts",
    "test:phase6": "dotenv -e .env.test -- ts-node -r tsconfig-paths/register --project scripts/tsconfig.json scripts/security/abuse-rate-limiting.security.ts",
    "quality:depcheck": "depcheck . --specials=eslint,typescript --ignores=@types/*,eslint*,prettier,@cyclonedx/*,detect-secrets,c8,vitest,ts-node,tsx,tsconfig-paths,lint-staged,husky,dotenv-cli,postcss,autoprefixer,@svgr/webpack,@vitest/coverage-v8,depcheck,license-checker,ts-prune,@swc/helpers,turbo",
    "quality:ts-prune": "node scripts/infrastructure/run-ts-prune.js",
    "quality:license": "node scripts/infrastructure/run-license-check.js"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^2.99.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.38.0",
    "@swc/helpers": "^0.5.20",
    "@tanstack/react-virtual": "^3.13.22",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^1.6.1",
    "bullmq": "^5.71.0",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.34.3",
    "ioredis": "^5.10.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "node-fetch": "^3.3.2",
    "osm-pbf-parser": "^2.3.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "18.3.1",
    "recharts": "^3.7.0",
    "sharp": "^0.34.5",
    "swagger-ui-react": "^5.32.4",
    "uuidv7": "^1.1.0",
    "web-vitals": "^5.1.0",
    "zod": "^3.22.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.1.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.19.37",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.2.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.0",
    "c8": "^10.0.0",
    "depcheck": "^1.4.7",
    "detect-secrets": "^1.0.6",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.12",
    "eslint-plugin-security": "^2.1.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "husky": "^9.0.0",
    "license-checker": "^25.0.0",
    "lint-staged": "^15.0.0",
    "postcss": "8.5.14",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}