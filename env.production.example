# Production values for Vercel (set in Project → Settings → Environment Variables).
# App project: Root Directory `apps/app` → domain cusownapp.clykur.com
# Marketing project: Root Directory `apps/marketing` → domain cusown.clykur.com
# Use the SAME variable names on both projects where listed.

NODE_ENV=production

# Domains (required on both projects)
NEXT_PUBLIC_APP_URL=https://cusownapp.clykur.com
NEXT_PUBLIC_MARKETING_URL=https://cusown.clykur.com

# Supabase (required — real project, not placeholders)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Server secrets (required on app project; marketing can omit if unused)
CRON_SECRET=GENERATE_WITH_openssl_rand_hex_32
SALON_TOKEN_SECRET=GENERATE_WITH_openssl_rand_hex_32

# Redis (recommended for app production)
REDIS_URL=rediss://default:PASSWORD@YOUR_UPSTASH_HOST:6379
REDIS_ENABLED=true

# Payments / webhooks (app only, when enabled)
# RAZORPAY_WEBHOOK_SECRET=
# UPI_WEBHOOK_SECRET=
# STRIPE_WEBHOOK_SECRET=

# Media / uploads
UPLOAD_STORAGE_BUCKET=uploads
SIGNED_URL_TTL_SECONDS=86400
MEDIA_STRIP_EXIF=true
MEDIA_VALIDATE_MAGIC_BYTES=true

# Optional monitoring
# NEXT_PUBLIC_SENTRY_DSN=

# Vercel sets these automatically — do not copy manually:
# VERCEL_ENV, VERCEL_URL, NEXT_PUBLIC_VERCEL_*
