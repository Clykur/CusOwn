{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"],
      "@/lib/*": ["./packages/shared/src/lib/*"],
      "@/config/*": ["./packages/config/src/*"],
      "@/services/*": ["./packages/shared/src/services/*"],
      "@/repositories/*": ["./packages/shared/src/repositories/*"],
      "@/types": ["./packages/shared/src/types/index.ts"],
      "@/types/*": ["./packages/shared/src/types/*"],
      "@/proxy": ["./apps/app/proxy.ts"],
      "@/app/*": ["./apps/app/app/*"],
      "@cusown/shared": ["./packages/shared/src/index.ts"],
      "@cusown/shared/server": ["./packages/shared/src/server.ts"],
      "@cusown/config": ["./packages/config/src/index.ts"],
      "@cusown/config/*": ["./packages/config/src/*"]
    }
  },
  "ts-node": {
    "esm": false,
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": [
    "types/**/*.d.ts",
    "*.ts",
    "unit-utils/**/*.ts",
    "api-routes/**/*.ts",
    "e2e/**/*.ts",
    "integration/**/*.ts",
    "security/**/*.ts"
  ]
}
